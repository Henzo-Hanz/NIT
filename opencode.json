{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "trello_*": "ask"
  },
  "mcp": {
    "trello": {
      "type": "local",
      "command": ["npx", "-y", "@thadeu/trello-mcp"],
      "enabled": true,
      "environment": {
        "TRELLO_API_KEY": "{env:TRELLO_API_KEY}",
        "TRELLO_TOKEN": "{env:TRELLO_TOKEN}",
        "TRELLO_ALLOWED_BOARD_IDS": "{env:TRELLO_BOARD_ID}"
      }
    }
  }
}
